[Unit]
Description=Reforesta Radar: daily Postgres backup (deploy/backup.sh)
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
# RADAR_APP; and, for the off-site copy, BACKUP_PAR_URL (root-only file, optional).
EnvironmentFile=/etc/reforesta-radar/deploy.env
EnvironmentFile=-/etc/reforesta-radar/backup.env
ExecStart=/usr/local/sbin/reforesta-radar-backup
