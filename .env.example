# Copy to .env (gitignored) to override the docker compose defaults. Everything is optional.
# Next.js also reads this file; none of these are exposed to the browser.

# --- docker compose (host side) ---
# Host ports. The dev server (`npm run dev`) uses 3000, so the compose frontend defaults to 3010.
RADAR_WEB_PORT=3010
RADAR_API_PORT=8010
RADAR_DB_PORT=5440
# Local development password only; set a real one anywhere else.
RADAR_DB_PASSWORD=radar
# Daily scheduled ingest, local time in Europe/Madrid (bulletins are out by then). If the machine is asleep at that
# time, the scheduler runs as soon as it wakes; it also runs right away when the database has never been ingested.
RADAR_INGEST_AT=09:00
# Switch sources off without touching code: comma-separated ids (bdns, boe, eu, bocm, dog, fb, rsc). They are not
# ingested, their calls are hidden and Fuentes shows them as "Desactivada"; their data stays in the database and
# comes back when the id is removed (docs/mantenimiento.md). Apply with `docker compose up -d`.
# RADAR_DISABLED_SOURCES=dog,bocm
# Time zone for "today" in deadlines and for RADAR_INGEST_AT.
# RADAR_TZ=Europe/Madrid

# --- Ingest (backend) ---
# Time budget of each source in one ingest run, and of the BDNS history step that runs after it (seconds).
# INGEST_SOURCE_TIMEOUT_S=480
# HISTORY_TIMEOUT_S=1800
# Requests in flight at once per host while ingesting, and the User-Agent sent (a generic client name, no e-mail).
# HTTP_CONCURRENCY=8
# HTTP_USER_AGENT=Mozilla/5.0 (compatible; ReforestaRadar/1.0)
# Browser origins allowed to call the API directly (the web goes through Next.js and needs none).
# CORS_ORIGINS=http://localhost:3000,http://localhost:3010

# --- «Revisión por IA» (ADR 0041, docs/backend.md) ---
# A second opinion from Google Gemini that takes out of the default list the calls whose topic has nothing to do
# with Reforesta (it never changes a score). Off while GEMINI_API_KEY is empty. Only the public text of each call
# (title, organism, kind, purpose) is sent to Google. Put the real key only in your .env, never in a committed file.
# GEMINI_API_KEY=
# Off switch that keeps the key: false behaves exactly as without a key.
# RADAR_AI_REVIEW=true
# RADAR_AI_MODEL=gemini-flash-lite-latest
# Calls sent to the model per ingest run at most (the rest wait for the next run; verdicts are cached).
# RADAR_AI_MAX_CALLS=300

# --- Accounts (docs/api-auth.md) ---
# Public URL of the web app: invitation and reset links are built on it.
# RADAR_PUBLIC_URL=http://localhost:3010
# Set to true when the site is served over https (Secure session cookie).
# RADAR_COOKIE_SECURE=false
# A session expires after this many days without use.
# RADAR_SESSION_DAYS=30
# Optional first admin on a fresh install, used only while there are no users. Prefer the command:
#   docker compose run --rm api python -m app.users create-admin <email>
# Remove both lines once the admin exists.
# RADAR_BOOTSTRAP_ADMIN_EMAIL=
# RADAR_BOOTSTRAP_ADMIN_PASSWORD=
# Optional e-mail: with SMTP_HOST and SMTP_FROM set, invitation/reset links are also e-mailed and
# "forgot password" is enabled. Without them, an admin copies the link and sends it personally.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# STARTTLS on SMTP_PORT (587). Set to false for a server that does not offer it.
# SMTP_STARTTLS=true
# Proxies whose X-Forwarded-For the API believes. Leave unset (127.0.0.1) unless a reverse proxy in front of the
# web container overwrites that header; then e.g. FORWARDED_ALLOW_IPS=172.16.0.0/12 (see docs/backend.md).
# FORWARDED_ALLOW_IPS=
# Argon2 password checks running at once (64 MiB each).
# RADAR_ARGON2_CONCURRENCY=2

# --- Read-only MCP server at /mcp (docs/mcp.md) ---
# Public tools without a token (same data as the landing). false: every request needs a personal token.
# RADAR_MCP_PUBLIC=true
# Requests per minute per client IP without a token.
# RADAR_MCP_PUBLIC_RATE=60
# URL shown in "Mi cuenta" for assistants (default: RADAR_PUBLIC_URL + /mcp).
# RADAR_MCP_URL=
# Extra Host / Origin values /mcp accepts (DNS-rebinding protection), comma-separated; "host:*" = any port.
# RADAR_MCP_ALLOWED_HOSTS=
# RADAR_MCP_ALLOWED_ORIGINS=
# Sign-in from the assistant (OAuth) at RADAR_MCP_URL + /equipo: the person pastes that address in their assistant,
# signs in on the radar and approves. Needs RADAR_PUBLIC_URL on https (or http://localhost for local use).
# RADAR_MCP_OAUTH=true
# stdio mode only (`docker compose run --rm -T api python -m app.mcp`): e-mail of the account whose team view it shows.
# RADAR_MCP_USER=

# --- Production only (docker-compose.prod.yml on Dokploy, docs/despliegue.md) ---
# Set in the Dokploy app's Environment (Dokploy writes them to the .env next to the compose files), never in git.
# Public hostname; DNS A record to the server, without a proxy. RADAR_PUBLIC_URL becomes https://<this>.
# RADAR_DOMAIN=radar.example.org
# A long random value, e.g. `openssl rand -hex 32`.
# RADAR_DB_PASSWORD=
# Fixed subnet of the project's network; FORWARDED_ALLOW_IPS is set to it in production.
# RADAR_NET_SUBNET=172.28.90.0/24
# Off-site backup (server only, /etc/reforesta-radar/backup.env, mode 600): write-only Object Storage PAR URL.
# BACKUP_PAR_URL=

# --- Next.js dev server (`npm run dev`) ---
# Where /api/* is proxied and where server components fetch from. Default: the compose API on the host.
# (Inside compose the frontend uses http://api:8000; that is set in docker-compose.yml, not here.)
# API_URL=http://localhost:8010

# --- Running the backend outside Docker (uv run …) ---
# DATABASE_URL is set by docker compose; outside it the default is the compose Postgres on the host:
# DATABASE_URL=postgresql+asyncpg://radar:radar@localhost:5440/radar
# Folder of the sample PDFs for POST /api/analyze-pdf {"sample": …} (compose mounts ./data/samples at /data/samples).
# RADAR_SAMPLES_DIR=data/samples
