# Copy to .env (gitignored) to override the docker compose defaults. Everything is optional.
# Next.js also reads this file; none of these are exposed to the browser.

# --- docker compose (host side) ---
# Host ports. The dev server (`npm run dev`) uses 3000, so the compose frontend defaults to 3010.
RADAR_WEB_PORT=3010
RADAR_API_PORT=8010
RADAR_DB_PORT=5440
# Local development password only; set a real one anywhere else.
RADAR_DB_PASSWORD=radar
# Daily scheduled ingest, local time in Europe/Madrid (bulletins are out by then). If the machine is asleep at that
# time, the scheduler runs as soon as it wakes; it also runs right away when the database has never been ingested.
RADAR_INGEST_AT=09:00

# --- Accounts (docs/api-auth.md) ---
# Public URL of the web app: invitation and reset links are built on it.
# RADAR_PUBLIC_URL=http://localhost:3010
# Set to true when the site is served over https (Secure session cookie).
# RADAR_COOKIE_SECURE=false
# Optional first admin on a fresh install, used only while there are no users. Prefer the command:
#   docker compose run --rm api python -m app.users create-admin <email>
# Remove both lines once the admin exists.
# RADAR_BOOTSTRAP_ADMIN_EMAIL=
# RADAR_BOOTSTRAP_ADMIN_PASSWORD=
# Optional e-mail: with SMTP_HOST and SMTP_FROM set, invitation/reset links are also e-mailed and
# "forgot password" is enabled. Without them, an admin copies the link and sends it personally.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# --- Next.js dev server (`npm run dev`) ---
# Where /api/* is proxied and where server components fetch from. Default: the compose API on the host.
# (Inside compose the frontend uses http://api:8000; that is set in docker-compose.yml, not here.)
# API_URL=http://localhost:8010
