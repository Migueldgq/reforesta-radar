# Compose variables of the e2e stack (e2e/docker-compose.e2e.yml). Used instead of the root .env, so a developer's
# own settings never leak in. Ports chosen not to collide with the default stack (3010/8010/5440) or `npm run dev`.
COMPOSE_PROJECT_NAME=radar-e2e
RADAR_WEB_PORT=3090
RADAR_API_PORT=8090
RADAR_DB_PORT=5490
RADAR_PUBLIC_URL=http://localhost:3090
# Throwaway database on 127.0.0.1 only; not a secret.
RADAR_DB_PASSWORD=radar
