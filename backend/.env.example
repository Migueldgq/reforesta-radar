# Copy to backend/.env and adjust. Never commit the copy (it is gitignored).
#
# docker compose works with the defaults below. To override ports or the password, run compose with
#   docker compose --env-file backend/.env up -d
# (a root .env would also be read by Next.js, so this project keeps its settings here).

# --- docker compose (host side) ---
# Local development password only; set a real one anywhere else.
RADAR_DB_PASSWORD=radar
# Host ports (5432 and 8000 are often taken).
RADAR_DB_PORT=5440
RADAR_API_PORT=8010
# ingest-scheduler profile: seconds between runs (8 h).
RADAR_INGEST_EVERY_S=28800

# --- app (API and ingest; inside compose, DATABASE_URL is set by docker-compose.yml) ---
# For `uv run --env-file .env ...` on the host, against the compose Postgres:
DATABASE_URL=postgresql+asyncpg://radar:radar@localhost:5440/radar
CORS_ORIGINS=http://localhost:3000
# Scoring counts days from local midnight in this zone.
RADAR_TZ=Europe/Madrid
HTTP_CONCURRENCY=8
# Per-source budget in a batch ingest run (seconds).
INGEST_SOURCE_TIMEOUT_S=480
