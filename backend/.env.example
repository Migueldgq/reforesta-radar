# Copy to backend/.env for running the API or the ingest on the host with `uv run --env-file .env ...`.
# Never commit the copy (it is gitignored). docker compose settings (ports, password, daily ingest time) live
# in the root .env instead (see ../.env.example).

# --- app (API and ingest; inside compose, DATABASE_URL is set by docker-compose.yml) ---
# For `uv run --env-file .env ...` on the host, against the compose Postgres:
DATABASE_URL=postgresql+asyncpg://radar:radar@localhost:5440/radar
CORS_ORIGINS=http://localhost:3000
# Scoring counts days from local midnight in this zone.
RADAR_TZ=Europe/Madrid
HTTP_CONCURRENCY=8
# Per-source budget in a batch ingest run (seconds).
INGEST_SOURCE_TIMEOUT_S=480
# Accounts: links point at the web app; the cookie is not Secure on plain http (see ../.env.example for the rest).
RADAR_PUBLIC_URL=http://localhost:3000
RADAR_COOKIE_SECURE=false
